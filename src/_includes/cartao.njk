<a class="news-card" href="{{ m.url }}">
  {% if m.data.imagem %}
  <div class="thumb"><img src="{{ m.data.imagem }}" alt="" loading="lazy" sizes="(max-width: 760px) 110px, 320px"><span class="tag">{{ m.data.categoria }}</span></div>
  {% else %}
  <div class="thumb sem-foto">F1<span class="tag">{{ m.data.categoria }}</span></div>
  {% endif %}
  <div class="news-body">
    <h3>{{ m.data.title }}</h3>
    {% if m.data.linha_fina %}<p>{{ m.data.linha_fina }}</p>{% endif %}
    <time datetime="{{ m.date | iso }}">{{ m.date | dataLonga }}</time>
  </div>
</a>
