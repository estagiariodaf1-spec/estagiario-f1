<script>
    (function () {
      var API_URL = 'https://api.jolpi.ca/ergast/f1/current/driverstandings.json';
      var TOP_N = 5;
      var containers = document.querySelectorAll('[data-driver-standings]');
      var seasonLabels = document.querySelectorAll('[data-standings-season]');

      if (!containers.length) return;

      function escapeHtml(value) {
        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function shortName(givenName, familyName) {
        var initial = String(givenName || '').trim().charAt(0);
        return (initial ? initial + '. ' : '') + String(familyName || '').trim();
      }

      function setSeason(season) {
        if (!season) return;
        var label = '· ' + season;
        seasonLabels.forEach(function (el) {
          el.textContent = label;
        });
      }

      function setBusy(busy) {
        containers.forEach(function (el) {
          el.setAttribute('aria-busy', busy ? 'true' : 'false');
        });
      }

      function renderLoading() {
        setBusy(true);
        var html = '<p class="standings-status">Carregando classificação…</p>';
        containers.forEach(function (el) {
          el.innerHTML = html;
        });
      }

      function renderError() {
        setBusy(false);
        var html = '<p class="standings-status">Não foi possível carregar a classificação.</p>';
        containers.forEach(function (el) {
          el.innerHTML = html;
        });
      }

      // Piloto favorito do leitor: fica só no navegador dele (sem cadastro, sem cookie).
      var CHAVE_FAV = 'estagiario-piloto-fav';
      function lerFav() { try { return localStorage.getItem(CHAVE_FAV) || ''; } catch (e) { return ''; } }
      function salvarFav(id) { try { id ? localStorage.setItem(CHAVE_FAV, id) : localStorage.removeItem(CHAVE_FAV); } catch (e) {} }
      var ultimaLista = [];

      function linha(entry, fav) {
        var driver = entry.Driver || {};
        var ehFav = driver.driverId === fav;
        return (
          '<div class="ranking-row' + (ehFav ? ' favorito' : '') + '">' +
            '<span><b class="rank-num">' + escapeHtml(entry.position) + '</b>' +
            escapeHtml(shortName(driver.givenName, driver.familyName)) + '</span>' +
            '<span class="ranking-dir"><strong>' + escapeHtml(entry.points) + '</strong>' +
            '<button type="button" class="estrela" data-fav="' + escapeHtml(driver.driverId) + '" aria-pressed="' + ehFav + '" ' +
            'aria-label="' + (ehFav ? 'Tirar ' : 'Marcar ') + escapeHtml(driver.familyName) + (ehFav ? ' dos favoritos' : ' como seu piloto') + '">' +
            (ehFav ? '★' : '☆') + '</button></span>' +
          '</div>'
        );
      }

      function renderStandings(standings) {
        ultimaLista = standings;
        var fav = lerFav();
        var top = standings.slice(0, TOP_N);
        var html = top.map(function (entry) { return linha(entry, fav); }).join('');
        var doFav = standings.find(function (e) { return (e.Driver || {}).driverId === fav; });
        if (doFav && top.indexOf(doFav) === -1) {
          html += '<div class="ranking-sep">Seu piloto</div>' + linha(doFav, fav);
        }
        var opcoes = standings.map(function (e) {
          var d = e.Driver || {};
          return '<option value="' + escapeHtml(d.driverId) + '"' + (d.driverId === fav ? ' selected' : '') + '>' +
            escapeHtml(e.position + 'º ' + d.givenName + ' ' + d.familyName) + '</option>';
        }).join('');
        html += '<label class="fav-escolha">' + (fav ? 'Trocar seu piloto' : 'Escolha seu piloto') +
          '<select data-escolha><option value="">—</option>' + opcoes + '</select></label>';

        setBusy(false);
        containers.forEach(function (el) {
          el.innerHTML = html;
        });
      }

      document.addEventListener('click', function (ev) {
        var b = ev.target.closest && ev.target.closest('[data-fav]');
        if (!b) return;
        salvarFav(lerFav() === b.dataset.fav ? '' : b.dataset.fav);
        renderStandings(ultimaLista);
      });
      document.addEventListener('change', function (ev) {
        if (!ev.target.matches || !ev.target.matches('[data-escolha]')) return;
        salvarFav(ev.target.value);
        renderStandings(ultimaLista);
      });

      async function loadDriverStandings() {
        renderLoading();
        try {
          var response = await fetch(API_URL);
          if (!response.ok) throw new Error('HTTP ' + response.status);

          var data = await response.json();
          var table = data && data.MRData && data.MRData.StandingsTable;
          var list = table && table.StandingsLists && table.StandingsLists[0];
          var standings = list && list.DriverStandings;

          if (!standings || !standings.length) throw new Error('empty');

          setSeason(table.season || list.season);
          renderStandings(standings);
        } catch (err) {
          console.warn('Classificação F1:', err);
          renderError();
        }
      }

      loadDriverStandings();
    })();
  </script>
