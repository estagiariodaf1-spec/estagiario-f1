{%- set urlPagina = page.url | absoluta(site.url) -%}
{%- set imagemCompartilhar = (imagem | comVersao | absoluta(site.url)) if imagem else ("/assets/estagiario.gif" | absoluta(site.url)) -%}
  <meta charset="utf-8">
  <link rel="icon" href="/favicon.ico?v=3" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/icones/favicon-32.png?v=3">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3">
  <link rel="manifest" href="/site.webmanifest?v=3">
  <meta name="theme-color" content="#0b0b0b">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.nome }}</title>
  <meta name="description" content="{{ linha_fina or descricao or site.descricao }}">
  {# max-image-preview:large libera a foto grande no Google Discover e nas notícias principais #}
  <meta name="robots" content="{{ 'noindex' if (noindex == true or noindex == 'sim') else 'index, follow, max-image-preview:large, max-snippet:-1' }}">
  <link rel="canonical" href="{{ urlPagina }}">
  <meta property="og:site_name" content="{{ site.nome }}">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:type" content="{{ 'article' if layout == 'materia.njk' else 'website' }}">
  <meta property="og:title" content="{{ chamada or title or site.nome }}">
  <meta property="og:description" content="{{ linha_fina or descricao or site.descricao }}">
  <meta property="og:url" content="{{ urlPagina }}">
  <meta property="og:image" content="{{ imagemCompartilhar }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@estagiariodaf1">
  {%- if layout == 'materia.njk' %}
  <meta property="article:published_time" content="{{ page.date | iso }}">
  <meta property="article:modified_time" content="{{ (atualizado or page.date) | iso }}">
  <meta property="article:section" content="{{ categoria or 'F1' }}">
  {%- endif %}
  {#- Quem é o site pro Google: veículo ligado ao Instagram e ao X do Estagiário #}
  <script type="application/ld+json">
  {"@context":"https://schema.org","@graph":[
    {"@type":"NewsMediaOrganization","@id":"{{ site.url }}/#org","name":{{ site.nome | dump | safe }},"url":"{{ site.url }}/",
     "logo":{"@type":"ImageObject","url":"{{ site.url }}/icones/icone-512.png","width":512,"height":512},
     "sameAs":[{{ site.redes.instagram | dump | safe }},{{ site.redes.x | dump | safe }}]},
    {"@type":"WebSite","@id":"{{ site.url }}/#site","name":{{ site.nome | dump | safe }},"url":"{{ site.url }}/","inLanguage":"pt-BR",
     "publisher":{"@id":"{{ site.url }}/#org"}}
  ]}
  </script>
  <link rel="alternate" type="application/rss+xml" title="{{ site.nome }}" href="/feed.xml">
  <link rel="stylesheet" href="/assets/site-nav.css">
  <link rel="stylesheet" href="/assets/css/home.css">
  <link rel="stylesheet" href="/assets/estilo.css">
  <script src="/assets/js/conta.js" defer></script>
