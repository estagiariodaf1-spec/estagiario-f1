---
layout: base.njk
---
<article class="materia">
  <span class="tag">{{ categoria }}</span>
  <h1>{{ title }}</h1>
  {% if linha_fina %}<p class="linha-fina">{{ linha_fina }}</p>{% endif %}
  <div class="assinatura">
    Por <b>{{ autor }}</b> · <time datetime="{{ page.date | iso }}">{{ page.date | dataHora }}</time>
    {% if atualizado %} · atualizado em <time datetime="{{ atualizado | iso }}">{{ atualizado | dataHora }}</time>{% endif %}
  </div>
  {% if imagem %}
  <figure class="foto">
    <img src="{{ imagem }}" alt="{{ imagem_descricao or title }}" loading="eager" fetchpriority="high" sizes="(max-width: 800px) 100vw, 760px">
    {% if credito_imagem %}<figcaption>{{ credito_imagem }}</figcaption>{% endif %}
  </figure>
  {% endif %}
  <div class="compartilhar" data-compartilhar data-titulo="{{ title }}" data-linha="{{ linha_fina }}" data-url="{{ page.url | absoluta(site.url) }}"
       data-imagem="{{ imagem }}" data-credito="{{ credito_imagem }}" data-slug="{{ page.fileSlug }}">
    <button type="button" data-acao="link">Compartilhar</button>
    <a class="whats" href="https://wa.me/?text={{ (title + ' ' + (page.url | absoluta(site.url))) | urlencode }}" target="_blank" rel="noopener" aria-label="Mandar no WhatsApp" title="WhatsApp">{% include "icones/whatsapp.svg" %}</a>
    <button type="button" data-acao="card">Card pro story</button>
  </div>
  <div class="texto">
    {{ content | safe }}
  </div>
</article>
<script src="/assets/js/components/compartilhar.js" defer></script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": {{ title | dump | safe }},
  {% if linha_fina %}"description": {{ linha_fina | dump | safe }},{% endif %}
  "datePublished": "{{ page.date | iso }}",
  "dateModified": "{{ (atualizado or page.date) | iso }}",
  "inLanguage": "pt-BR",
  "articleSection": {{ (categoria or "F1") | dump | safe }},
  "author": { "@type": "Organization", "name": {{ autor | dump | safe }}, "url": "{{ site.url }}/quem-somos/" },
  "publisher": { "@id": "{{ site.url }}/#org" },
  "image": ["{{ (imagem | comVersao | absoluta(site.url)) if imagem else (site.url + '/icones/icone-512.png') }}"],
  "mainEntityOfPage": "{{ page.url | absoluta(site.url) }}"
}
</script>
