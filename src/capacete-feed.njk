---
permalink: /por-tras-do-capacete/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Por trás do capacete · {{ site.nome }}</title>
    <link>{{ site.url }}/por-tras-do-capacete/</link>
    <description>{{ capacete.descricao }}</description>
    <language>pt-BR</language>
    <atom:link href="{{ site.url }}/por-tras-do-capacete/feed.xml" rel="self" type="application/rss+xml"/>
    {%- for m in collections.capacete | primeiros(30) %}
    <item>
      <title>{{ m.data.title }}</title>
      <link>{{ m.url | absoluta(site.url) }}</link>
      <guid>{{ m.url | absoluta(site.url) }}</guid>
      <pubDate>{{ m.date | rfc822 }}</pubDate>
      <description>{{ m.data.descricao }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
