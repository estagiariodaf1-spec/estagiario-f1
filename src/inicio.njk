---
permalink: "{{ '/' if site.lancado else '/home.html' }}"
eleventyExcludeFromCollections: true
eleventyComputed:
  noindex: "{{ 'sim' if not site.lancado else '' }}"
---
{%- set inicio = "/" if site.lancado else "/home.html" -%}
{%- set materias = collections.materias -%}
{%- set capa = materias[0] -%}
<!doctype html>
<html lang="pt-BR">
<head>
{% include "cabeca.njk" %}
  <link rel="stylesheet" href="/assets/css/calendar.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="/assets/css/calendar.css"></noscript>
</head>
<body>
  <div class="page">
    {% include "topo.njk" %}

    <div class="gp-faixa-espaco" data-gp-faixa aria-live="polite"><div class="gp-faixa carregando">Carregando o fim de semana de GP…</div></div>

    <main class="hero-grid">
      {% if capa %}
      {% set destaques = materias | primeiros(5) %}
      <div class="hero-carrossel" data-hero aria-roledescription="carrossel" aria-label="Destaques">
        {% for m in destaques %}
        <a class="hero hero-slide{% if loop.first %} ativo{% endif %}" href="{{ m.url }}"{% if not loop.first %} tabindex="-1" aria-hidden="true"{% endif %}>
          {% if m.data.imagem %}<img class="hero-img" src="{{ m.data.imagem }}" alt="" sizes="(max-width: 760px) 100vw, 900px"{% if loop.first %} loading="eager" fetchpriority="high"{% else %} loading="lazy"{% endif %}>{% endif %}
          <div class="hero-content">
            <span class="tag">{{ m.data.categoria }}</span>
            {% if loop.first %}<h1>{{ m.data.title }}</h1>{% else %}<h2 class="hero-titulo">{{ m.data.title }}</h2>{% endif %}
            {% if m.data.linha_fina %}<p>{{ m.data.linha_fina }}</p>{% endif %}
            <span class="button">Ler matéria completa</span>
          </div>
        </a>
        {% endfor %}
        {% if destaques.length > 1 %}
        <div class="hero-controles">
          <button class="hero-seta" type="button" data-hero-anterior aria-label="Destaque anterior">‹</button>
          <div class="hero-pontos" data-hero-pontos>
            {% for m in destaques %}<button type="button" aria-label="Destaque {{ loop.index }}"{% if loop.first %} class="ativo"{% endif %}></button>{% endfor %}
          </div>
          <button class="hero-seta" type="button" data-hero-proxima aria-label="Próximo destaque">›</button>
        </div>
        {% endif %}
      </div>
      {% else %}
      <section class="hero">
        <div class="hero-content">
          <span class="tag">F1</span>
          <h1>A primeira matéria está chegando</h1>
          <p>O Estagiário está terminando a apuração.</p>
        </div>
      </section>
      {% endif %}

      <aside class="sidebar">
        <div class="black-card next-race-card">
          <h3>Próxima corrida</h3>
          <div data-next-race-content>
            <div class="next-race-status">Carregando próxima corrida…</div>
          </div>
        </div>
        <div class="black-card driver-standings-sidebar">
          <h3>Classificação pilotos <span class="standings-season" data-standings-season></span></h3>
          <div data-driver-standings aria-live="polite" aria-busy="true"></div>
          <a class="link-class-full" href="/estatisticas.html">Classificação completa ›</a>
        </div>
      </aside>
    </main>

    <section class="section">
      <div class="section-head">
        <h2 class="section-title">Últimas notícias</h2>
        <a class="see-more" href="/noticias/">Ver todas ›</a>
      </div>
      {% set lista = materias | depois(1) | primeiros(8) %}
      {% if lista.length %}
      <div class="news-grid">
        {% for m in lista %}{% include "cartao.njk" %}{% endfor %}
      </div>
      {% else %}
      <div class="vazio">Em breve, mais notícias por aqui.</div>
      {% endif %}
    </section>

    <section class="section">
      <div class="section-head"><h2 class="section-title">Nas redes</h2></div>
      <div class="vitrine-grid">
        {% for rede in [["instagram", "Instagram", site.redes.instagram], ["x", "X", site.redes.x]] %}
        <div class="vitrine-caixa" data-vitrine="{{ rede[0] }}">
          <div class="vitrine-topo"><b class="vitrine-rede" aria-label="{{ rede[1] }}" title="{{ rede[1] }}">{% include "icones/" + rede[0] + ".svg" %}</b><a href="{{ rede[2] }}" target="_blank" rel="noopener noreferrer">@estagiariodaf1 ›</a></div>
          <div class="vitrine-janela"><div class="vitrine-trilho" data-trilho></div></div>
          <div class="vitrine-pontos" data-pontos></div>
          <div class="vitrine-convite">As últimas do Estagiário no {{ rede[1] }}.<br><a href="{{ rede[2] }}" target="_blank" rel="noopener noreferrer">Seguir no {{ rede[1] }}</a></div>
        </div>
        {% endfor %}
      </div>
    </section>

    <section class="section">
      <div data-f1-calendar>
        <div class="f1-calendar-shell">
          <div class="f1-calendar-status">Carregando calendário da F1…</div>
        </div>
      </div>
    </section>

    {% include "rodape.njk" %}
  </div>
  <script src="/assets/site-nav.js" defer></script>
  <script src="/assets/js/api/f1-api.js" defer></script>
  <script src="/assets/js/data/circuit-details.js" defer></script>
  <script src="/assets/js/components/next-race-card.js" defer></script>
  <script src="/assets/js/components/f1-calendar.js" defer></script>
  <script src="/assets/js/components/vitrine-redes.js" defer></script>
  <script src="/assets/js/components/hero-carrossel.js" defer></script>
  <script src="/assets/js/components/gp-fim-de-semana.js" defer></script>
  <script>
  document.addEventListener('DOMContentLoaded', function () {
    GPFimDeSemana.mount('[data-gp-faixa]');
    NextRaceCard.mount('[data-next-race-content]');
    F1Calendar.mount('[data-f1-calendar]');
    VitrineRedes.mount({{ site.vitrine_url | dump | safe }});
  });
  </script>
  {% include "classificacao-script.njk" %}
</body>
</html>
