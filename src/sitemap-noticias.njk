permalink: /sitemap-noticias.xml
eleventyExcludeFromCollections: true
---
{#- Sitemap de notícias do Google: só as matérias dos últimos 2 dias (regra do Google News). -#}
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">
  {%- for m in collections.materiasRecentes %}
  <url>
    <loc>{{ m.url | absoluta(site.url) }}</loc>
    <news:news>
      <news:publication><news:name>{{ site.nome }}</news:name><news:language>pt</news:language></news:publication>
      <news:publication_date>{{ m.date | iso }}</news:publication_date>
      <news:title>{{ m.data.title | escape }}</news:title>
    </news:news>
  </url>
  {%- endfor %}
</urlset>
