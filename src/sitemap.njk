---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc></url>
  <url><loc>{{ site.url }}/noticias/</loc></url>
  {%- for p in ["/quem-somos/", "/expediente/", "/contato/", "/privacidade/", "/calendario.html", "/calendario-f1-2027/", "/estatisticas.html", "/gp.html", "/pilotos.html", "/equipes.html", "/comparador.html"] %}
  <url><loc>{{ site.url }}{{ p }}</loc></url>
  {%- endfor %}
  {%- for a in assuntos %}{% if (collections.materias | materiasDoAssunto(a.slug)).length %}
  <url><loc>{{ site.url }}/{{ a.tipo }}/{{ a.slug }}/</loc></url>
  {%- endif %}{% endfor %}
  {%- if collections.capacete.length %}
  <url><loc>{{ site.url }}/por-tras-do-capacete/</loc></url>
  {%- for m in collections.capacete %}
  <url><loc>{{ m.url | absoluta(site.url) }}</loc><lastmod>{{ (m.data.atualizado or m.date) | iso }}</lastmod></url>
  {%- endfor %}{% endif %}
  {%- for m in collections.materias %}
  <url><loc>{{ m.url | absoluta(site.url) }}</loc><lastmod>{{ (m.data.atualizado or m.date) | iso }}</lastmod></url>
  {%- endfor %}
</urlset>
